# Copia este fichero a `.env` (sin extension) y pon tu clave.
#
#     cp .env.ejemplo .env
#
# `.env` esta en el .gitignore: no se sube nunca. Este ejemplo si.
# Se arranca con:  npm run start:ia
# (node lee el fichero de forma nativa con --env-file, sin instalar dotenv)

OPENAI_API_KEY=sk-pon-aqui-tu-clave

# El modelo. Por defecto gpt-5.6-sol. Si el identificador real de la API es
# otro, cambialo aqui y no hace falta tocar codigo.
OPENAI_MODEL=gpt-5.6-sol
