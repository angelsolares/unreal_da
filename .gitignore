Content/__ExternalActors__/Sword_Takedown/
Content/__ExternalActors__/Throwing_Pack/
Content/__ExternalActors__/KnockdownGetUp/
Content/__ExternalActors__/Anime_Dual_Dagger/
Content/__ExternalActors__/Sword_Duel_Pack/
Content/__ExternalActors__/Spear/
Content/__ExternalObjects__/

# Cache de los scripts de Python del MCP.
Tools/MCP/__pycache__/

